# Copie este arquivo para .env apenas para rodar LOCALMENTE.
# Em produção (Hugging Face Spaces), configure estes valores em
# Settings -> Repository secrets do Space — nunca commit valores reais.

PORT=7860

# Chave da API da Anthropic (Claude). NUNCA cole valores reais em arquivos versionados.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Personalidade do agente. Deixe em branco para usar o padrão em lib/claude.js,
# ou escreva um prompt descrevendo o Daniel real (tom de voz, contexto, regras).
SYSTEM_PROMPT=

# Supabase
SUPABASE_URL=https://eyntrzbszzjjwaveynpj.supabase.co
# Use a service_role key (Settings -> API no painel do Supabase), NÃO a anon/publishable key.
# A service_role key nunca deve ser usada em código de frontend, apenas aqui no backend.
SUPABASE_SERVICE_KEY=

# Transcrição de áudio (Whisper). Opcional — sem isso, áudios recebem um aviso em vez de resposta.
OPENAI_API_KEY=

# Lista de números (só dígitos, com DDI, ex: 5511999999999) que o bot deve responder.
# Deixe vazio para responder a todos (recomendado só depois de testar com a allowlist).
ALLOWED_NUMBERS=

# Responder mensagens de grupos? (false recomendado para começar)
ALLOW_GROUPS=false

LOG_LEVEL=info
